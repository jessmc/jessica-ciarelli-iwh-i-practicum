doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body    
        h1 Genshin Impact Characters
        a(href="/update-cobj") Add to this table
        table
            thead
                tr
                    th Name
                    th Vision
                    th Location
            tbody
                each character in data
                    tr
                        td #{character.properties.name}
                        td #{character.properties.vision}
                        td #{character.properties.location}