doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body    
        h1 Update Genshin Impact Character
        a(href="/") Return to the homepage
        form(action="/update-cobj" method="POST")
            label(for="name") Name
            input(type="text" id="name" name="name")
            label(for="vision") Vision
            select(name="vision" id="vision")
                option(value="anemo") Anemo
                option(value="geo") Geo
                option(value="electro") Electro
                option(value="dendro") Dendro
                option(value="hydro") Hydro
                option(value="pyro") Pyro
                option(value="cryo") Cryo

            label(for="location") Location
            input(type="text" id="location" name="location")
            input(type="submit" value="Update Character")